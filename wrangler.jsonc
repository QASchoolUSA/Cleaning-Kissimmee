{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "cleaning-kissimmee",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cleaning-kissimmee"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "BOOKING_OUTBOX",
      "id": "REPLACE_WITH_BOOKING_OUTBOX_KV_ID",
      "preview_id": "REPLACE_WITH_BOOKING_OUTBOX_KV_PREVIEW_ID"
    }
  ],
  "vars": {
    "BOOKING_BROOM_SITE_SLUG": "kissimmee",
    "BOOKING_BROOM_API_KEY": "bb_kissimmee_dev_key"
  }
}
